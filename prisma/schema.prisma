generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Modelo de Clientes 
model Cliente { 
  id               String    @id @default(uuid()) 
  nome             String 
  whatsapp         String? 
  dataCriacao      DateTime  @default(now()) 
   
  pedidos          Pedido[] 

  @@map("clientes") 
} 

// Modelo de Categorias do Catálogo
model Categoria {
  id               String            @id @default(uuid())
  nome             String            @unique // Ex: "Reforma", "Confecção", "Bordado"
  catalogoServicos CatalogoServico[]

  @@map("categorias")
}

// Catálogo de tipos de serviços e preços base 
model CatalogoServico { 
  id          String        @id @default(uuid()) 
  nome        String        // Ex: "Fazer Barra", "Ajuste de Cintura"
  precoBase   Decimal       @db.Decimal(10, 2) 
  
  categoriaId String
  categoria   Categoria     @relation(fields: [categoriaId], references: [id])
   
  servicosItem ServicoItem[] 

  @@map("catalogo_servicos") 
} 

// NÍVEL 1: A Ordem de Serviço (Mestre)
model Pedido { 
  id                  String       @id @default(uuid()) 
  clienteId           String 
  valorTotal          Decimal      @db.Decimal(10, 2) 
  status              Status       @default(PENDENTE) 
  dataEntrada         DateTime     @default(now()) 
  dataEntregaPrevista DateTime 
  dataConclusao       DateTime? 
  dataRetirada        DateTime? 

  cliente             Cliente      @relation(fields: [clienteId], references: [id]) 
  itens               ItemPedido[]
  transacoes          Transacao[]

  @@map("pedidos") 
} 

// NÍVEL 2: A Peça de Roupa (Detalhe)
model ItemPedido {
  id            String        @id @default(uuid())
  pedidoId      String
  descricaoPeca String        
  observacoes   String?       

  pedido        Pedido        @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  servicos      ServicoItem[] 

  @@map("itens_pedido")
}

// NÍVEL 3: Os serviços escolhidos para cada Peça
model ServicoItem {
  id                String          @id @default(uuid())
  itemPedidoId      String
  catalogoServicoId String
  precoCobrado      Decimal         @db.Decimal(10, 2) 

  itemPedido        ItemPedido      @relation(fields: [itemPedidoId], references: [id], onDelete: Cascade)
  catalogoServico   CatalogoServico @relation(fields: [catalogoServicoId], references: [id])

  @@map("servicos_item")
}

// Registro financeiro (Fluxo de Caixa) 
model Transacao { 
  id            String    @id @default(uuid()) 
  valor         Decimal   @db.Decimal(10, 2) 
  tipo          TipoTransacao
  categoria     String 
  data          DateTime  @default(now()) 
  observacao    String? 

  pedidoId      String?
  pedido        Pedido?   @relation(fields: [pedidoId], references: [id], onDelete: SetNull)

  @@map("transacoes") 
} 

// NOVO: Modelos de Mensagens para WhatsApp
model ModeloMensagem {
  id           String    @id @default(uuid())
  titulo       String    // Ex: "Aviso de Pedido Pronto", "Confirmação de Entrada"
  conteudo     String    // Texto com placeholders: {cliente}, {pecas}, {valor}, {prazo}
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  @@map("modelos_mensagem")
}

enum Status { 
  PENDENTE 
  PRONTO            
  ENTREGUE          
  ATRASADO_RETIRADA 
} 

enum TipoTransacao { 
  ENTRADA 
  SAIDA 
}